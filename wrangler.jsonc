{
  "name": "masayakawai",
  "main": "worker/index.ts",
  "compatibility_date": "2025-03-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/* は静的アセットより先に Worker で処理する
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // 受信先と送信元のアドレス。Cloudflare のダッシュボードでも上書きできる
  "vars": {
    "CONTACT_TO": "",
    "CONTACT_FROM": ""
  }
  // シークレット(ダッシュボードか `wrangler secret put` で設定):
  //   TURNSTILE_SECRET_KEY, RESEND_API_KEY
}
